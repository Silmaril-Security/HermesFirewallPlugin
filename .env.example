# Required Hermes Firewall runtime configuration. Do not commit real API keys.
SILMARIL_API_KEY=replace-me
SILMARIL_API_URL=https://your-endpoint.execute-api.us-west-2.amazonaws.com/alpha/classify

# Optional runtime controls.
HERMES_FIREWALL_BLOCK_MALICIOUS=false
HERMES_FIREWALL_SDK_TIMEOUT_SECONDS=2.0
HERMES_FIREWALL_SDK_MAX_RETRIES=0
HERMES_FIREWALL_MAX_PAYLOAD_CHARS=8000

# Optional public demo preview override for scripts/open_playground.py.
SILMARIL_DEMO_BASE_URL=https://app.silmaril.dev
